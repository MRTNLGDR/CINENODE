# Local runtime
CINENODE_HOME=./data
CINENODE_HOST=127.0.0.1
CINENODE_PORT=8787
CINENODE_MAX_UPLOAD_BYTES=8589934592
CINENODE_COMMAND_TIMEOUT_SECONDS=14400
CINENODE_ALLOW_SHUTDOWN=true
CINENODE_ALLOW_LOOPBACK_PROXY=false

# Optional custom paths
CINENODE_MODELS_DIR=./data/models
CINENODE_ENGINES_DIR=./data/engines
# CINENODE_FRONTEND_DIR=./source/frontend
# CINENODE_DB=./data/cinenode.sqlite3

# Optional setup-only token for gated Hugging Face files. Never commit a real value.
HF_TOKEN=
